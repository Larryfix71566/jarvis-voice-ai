<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  MORTIMER_MODEL_DISCIPLINE_AND_MAC_SHELL_PLAN.md B0.

  Apply via Xcode > MortimerShell target > Signing & Capabilities:
    + Capability > App Sandbox
      - check "Audio Input" under Hardware
      - check "Outgoing Connections (Client)" under Network (the shell
        loads http://127.0.0.1:5173 — see B4; this is loopback-only, no
        server capability needed)

  Xcode writes these into its own generated .entitlements file when you
  check those boxes in the UI; this template documents the exact keys it
  should produce, for a later real .xcodeproj or for manual verification.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
