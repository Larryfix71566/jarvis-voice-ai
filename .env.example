# ============================================================================
# NOTE — credential vault (MORTIMER_CREDENTIAL_VAULT_PLAN.md): API keys and
# tokens can live in an encrypted vault (data/secrets.vault, master key in
# the macOS Keychain) instead of plaintext here. Set them below to get
# started, then run:
#     python -m jarvis.vault init
#     python -m jarvis.vault migrate
# which moves every credential into the vault and comments out its line
# here. After that, .env holds CONFIGURATION ONLY; a non-empty env var
# still overrides the vault (deliberate CI/experiment channel).
#   JARVIS_VAULT_ENABLED=true    # kill switch; false = pre-vault behavior
#   JARVIS_VAULT_PATH=data/secrets.vault
#   JARVIS_VAULT_KEY=            # base64 32-byte key — only for headless/CI
#                                # boxes without a keychain (export-key)
# ============================================================================

# Deepgram (speech-to-text) — console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs (text-to-speech) — elevenlabs.io
ELEVENLABS_API_KEY=

# OpenAI-compatible Chat Completions endpoint for the SUPERVISOR + sub-agents.
# Any provider with tool calling works; some ready-made blocks:
#
#   OpenAI (default):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
#
#   Moonshot/Kimi:      OPENAI_BASE_URL=https://api.moonshot.ai/v1
#                       OPENAI_MODEL=kimi-k2.5
#                       (kimi-k2.x rejects temperature != 1 — Mortimer omits
#                        the parameter by default; see DEVIATIONS.md D-003)
#
#   Anthropic Claude:   OPENAI_BASE_URL=https://api.anthropic.com/v1/
#                       OPENAI_MODEL=claude-haiku-4-5   # lowest latency
#
#   Local Ollama:       OPENAI_BASE_URL=http://localhost:11434/v1
#                       OPENAI_MODEL=qwen3:32b

# Tavily (web search for the Analyst) — app.tavily.com
TAVILY_API_KEY=

# --- App development (optional; enables mcp-apps) ---
# PAT that can create repos and read/write contents — github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=            # user/org owning app repos (defaults to token's user)

# --- Upgrade Agent planners (self-development loop) ---
# Keys for the model profiles in config/upgrade_models.yaml. A profile is
# usable once its key is set; the picker shows which profiles are ready.
MOONSHOT_API_KEY=        # kimi-k3 (default), kimi-k2
ANTHROPIC_API_KEY=       # claude-opus
# (gpt-4.1-mini reuses OPENAI_API_KEY above — set it to an OpenAI key if you
#  want that profile while the main brain runs on another provider.)
# Default planner when a session doesn't choose one (overrides the registry):
# JARVIS_UPGRADE_PROFILE=kimi-k3

# --- Self-development PR creation (optional; enables edit-mode submit) ---
# Fine-grained PAT scoped to THIS repo only: Contents (read/write) +
# Pull requests (read/write). NO administration, NO other repos. The agent
# can only ever open PRs — keep main a protected branch and merge yourself.
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_REPO=Larryfix71566/jarvis-voice-ai

# --- Wake word (optional stretch) ---
# JARVIS_WAKEWORD_PORT=7862
# JARVIS_WAKEWORD_MODEL=models/mortimer.onnx
# JARVIS_WAKEWORD_THRESHOLD=0.5
# JARVIS_WAKEWORD_COOLDOWN=2.0

# --- Noise suppression (optional; voice isolation plan, Workstream A) ---
# Server-side neural noise suppression on the mic stream. OFF by default;
# enable for the A/B cohort with JARVIS_NS_ENABLED=true. Install one engine:
#   pip install deepfilternet   # DeepFilterNet 3 (best quality; pulls torch)
#   pip install pyrnnoise       # RNNoise (lighter fallback, plan A0)
# JARVIS_NS_ENABLED=false
# JARVIS_NS_FILTER=deepfilternet   # deepfilternet | rnnoise | null | none
# JARVIS_NS_ATTEN_LIM_DB=          # empty = full suppression; e.g. 12 keeps a
#                                  # natural noise floor (plan A3 strength knob)
# JARVIS_NS_POST_FILTER=false
# JARVIS_NS_LOG_STATS=true         # [ns] RTF/latency telemetry in logs/bot.log

# --- Misc overrides (rarely needed) ---
# JARVIS_INTERRUPTION_NOTICE_ENABLED=true  # tell the Supervisor when the
#                                           # user genuinely barged in on a
#                                           # reply (plan Phase 3); set false
#                                           # to disable the context note
# JARVIS_MAX_PARALLEL_DELEGATIONS=3        # cap concurrent delegate_task
#                                           # executions when the Supervisor
#                                           # issues several in one turn
#                                           # (plan Phase 4)
# JARVIS_RUNLOG_ENABLED=true               # durable per-run logs for every
#                                           # sub-agent delegation (agent_runs/
#                                           # agent_events + logs/agents/*.jsonl);
#                                           # false is the kill switch — every
#                                           # write becomes a no-op
# JARVIS_RUNLOG_RETENTION_DAYS=30          # prune run-log rows/files older
#                                           # than this, once at bot startup;
#                                           # <= 0 disables pruning
# JARVIS_MEMORY_SWEEP_INTERVAL_S=300       # how often a live session's
#                                           # transcript is folded into
#                                           # long-term memory while it is
#                                           # still running, not just at
#                                           # teardown (reliable-memory plan)
# JARVIS_PROCEDURES_ENABLED=true           # learn + inject procedure hints
#                                           # from successful sub-agent runs
#                                           # (memory/procedures plan Part B);
#                                           # false is the kill switch — every
#                                           # write and every hint lookup
#                                           # becomes a no-op
# JARVIS_COUNCIL_ENABLED=true              # LLM Council for the self-edit
#                                           # loop's escalation path
#                                           # (MORTIMER_LLM_COUNCIL_PLAN.md);
#                                           # false is the kill switch — no
#                                           # fan-out, no logging, no cost;
#                                           # escalation falls through to the
#                                           # ordinary report-and-stop failure;
#                                           # read from the process
#                                           # environment — the run scripts
#                                           # export this file (V3)
# JARVIS_UI_CONTROL_ENABLED=true           # voice control of the console
#                                           # UI (drawer/tabs/transcript/
#                                           # display windows/mic/wake,
#                                           # MORTIMER_VOICE_UI_PLAN.md);
#                                           # false is the kill switch —
#                                           # the ui_control tool is not
#                                           # registered and the prompt
#                                           # addendum is omitted; buttons
#                                           # are unaffected
# JARVIS_COUNCIL_RETENTION_DAYS=180         # prune council_rounds/
#                                           # council_scores rows and
#                                           # logs/council/ dirs older than
#                                           # this, once at bot startup;
#                                           # <= 0 disables pruning. Kept
#                                           # much longer than the runlog's
#                                           # 30 days — pruning faster than
#                                           # shadowed rounds accumulate
#                                           # (25% sample) would permanently
#                                           # starve the judge-tier
#                                           # promotion decision (V11)
# JARVIS_DB_PATH=data/jarvis.db
# JARVIS_LOG_LEVEL=INFO
# JARVIS_BOT_PORT=7860
# JARVIS_WEBRTC_ENDPOINT=http://localhost:7860/api/offer
# JARVIS_TIMEZONE=America/New_York
# JARVIS_USER_NAME=Boss
# JARVIS_NAME=Mortimer
# JARVIS_ADMIN_URL=http://127.0.0.1:7861   # where mcp-selfedit finds the sidecar
