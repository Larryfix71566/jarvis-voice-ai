# ── Mortimer configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in your keys. .env is gitignored — never
# commit real keys.

# ── Required ──────────────────────────────────────────────────────────────
# LLM (any OpenAI-compatible Chat Completions endpoint with tool calling)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Speech-to-text (Deepgram)
DEEPGRAM_API_KEY=

# Text-to-speech (ElevenLabs)
ELEVENLABS_API_KEY=

# Web search for the Analyst (Tavily)
TAVILY_API_KEY=

# ── Optional: alternative LLM providers (uncomment one block) ─────────────
# Moonshot / Kimi — NOTE: kimi-k2.x rejects any temperature != 1, so Mortimer
# omits the temperature parameter by default (see DEVIATIONS.md D-003).
# OPENAI_BASE_URL=https://api.moonshot.ai/v1
# OPENAI_MODEL=kimi-k2.5
#
# Anthropic Claude via its OpenAI-compatibility layer (haiku = lowest latency)
# OPENAI_BASE_URL=https://api.anthropic.com/v1/
# OPENAI_MODEL=claude-haiku-4-5

# ── Optional: upgrade planner models (self-development edit mode) ─────────
# Planner profiles live in config/upgrade_models.yaml; their keys live here.
# MOONSHOT_API_KEY=        # kimi-k2 (default planner) and kimi-k3
# ANTHROPIC_API_KEY=       # claude-opus
# JARVIS_UPGRADE_PROFILE=  # override the registry default planner
# JARVIS_UPGRADE_MODELS=   # point at an alternate registry file

# ── Optional: self-development PR creation ────────────────────────────────
# Fine-grained PAT scoped to THIS repo only: Contents (read/write) +
# Pull requests (read/write). No administration, no other repos.
# JARVIS_GITHUB_TOKEN=
# JARVIS_GITHUB_REPO=Larryfix71566/jarvis-voice-ai
# JARVIS_ADMIN_URL=http://127.0.0.1:7861

# ── Optional: app development (mcp-apps) ──────────────────────────────────
# GITHUB_TOKEN=            # PAT that can create repos and read/write contents
# GITHUB_OWNER=            # defaults to the token's user

# ── Optional: wake word (openWakeWord sidecar) ────────────────────────────
# JARVIS_WAKEWORD_PORT=7862
# JARVIS_WAKEWORD_MODEL=models/mortimer.onnx
# JARVIS_WAKEWORD_THRESHOLD=0.5
# JARVIS_WAKEWORD_COOLDOWN=2.0

# ── Optional: misc ────────────────────────────────────────────────────────
# JARVIS_DB_PATH=data/jarvis.db
# JARVIS_LOG_LEVEL=INFO
# JARVIS_BOT_PORT=7860
# JARVIS_WEBRTC_ENDPOINT=http://localhost:7860/api/offer
# JARVIS_TIMEZONE=America/New_York
# JARVIS_USER_NAME=Boss
# JARVIS_NAME=Mortimer
