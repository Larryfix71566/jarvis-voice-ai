# ============================================================================
# NOTE — credential vault (MORTIMER_CREDENTIAL_VAULT_PLAN.md): API keys and
# tokens can live in an encrypted vault (data/secrets.vault, master key in
# the macOS Keychain) instead of plaintext here. Set them below to get
# started, then run:
#     python -m jarvis.vault init
#     python -m jarvis.vault migrate
# which moves every credential into the vault and comments out its line
# here. After that, .env holds CONFIGURATION ONLY; a non-empty env var
# still overrides the vault (deliberate CI/experiment channel).
#   JARVIS_VAULT_ENABLED=true    # kill switch; false = pre-vault behavior
#   JARVIS_VAULT_PATH=data/secrets.vault
#   JARVIS_VAULT_KEY=            # base64 32-byte key — only for headless/CI
#                                # boxes without a keychain (export-key)
# ============================================================================

# Deepgram (speech-to-text) — console.deepgram.com
DEEPGRAM_API_KEY=

# ElevenLabs (text-to-speech) — elevenlabs.io
ELEVENLABS_API_KEY=

# OpenAI-compatible Chat Completions endpoint for the voice SUPERVISOR /
# ORCHESTRATOR ONLY. Sub-agents and background work use the registry profiles
# below and never inherit this model or credential implicitly.
# Any provider with tool calling works; some ready-made blocks:
#
#   OpenAI (default):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Model Use Enhancements. Route choices are direct_api, subscription,
# codex_subscription, saygm, or local. Subscription routes require the
# official runtime sign-in; SAYGM
# requires a vault-provided SAYGM_API_KEY. Never put credentials in this file.
JARVIS_MODEL_ACCESS_CONFIG=config/model_access.yaml
JARVIS_MODEL_ROUTE_VOICE_SUPERVISOR=direct_api
JARVIS_MODEL_ROUTE_MEMORY=direct_api
JARVIS_MODEL_ROUTE_BACKGROUND=direct_api
#
#   Moonshot/Kimi:      OPENAI_BASE_URL=https://api.moonshot.ai/v1
#                       OPENAI_MODEL=kimi-k2.5
#                       (kimi-k2.x rejects temperature != 1 — Mortimer omits
#                        the parameter by default; see DEVIATIONS.md D-003)
#
#   Anthropic Claude:   OPENAI_BASE_URL=https://api.anthropic.com/v1/
#                       OPENAI_MODEL=claude-haiku-4-5   # lowest latency
#
#   Local Ollama:       OPENAI_BASE_URL=http://localhost:11434/v1
#                       OPENAI_MODEL=qwen3:32b

# Tavily (web search for the Analyst) — app.tavily.com
TAVILY_API_KEY=

# --- App development (optional; enables mcp-apps) ---
# PAT that can create repos and read/write contents — github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_OWNER=            # user/org owning app repos (defaults to token's user)

# --- Upgrade Agent planners (self-development loop) ---
# Keys for the model endpoints in config/model_endpoints.yaml. A profile is
# usable once its key is set; the picker shows which profiles are ready.
MOONSHOT_API_KEY=        # kimi-k3, kimi-k2
ANTHROPIC_API_KEY=       # claude-opus, claude-fable-5
OPENROUTER_API_KEY=      # every or-* profile: one key, many vendors
#
# OPENROUTER (Larry 2026-08-19) covers the council and planner tiers plus the
# developer agent's build model (or-codex-max). It is NOT used for the voice
# model, which stays on a direct key: voice is latency-critical and wants no
# proxy hop, and keeping it on a separate credential means an OpenRouter
# outage cannot leave Mortimer unable to speak.
#
# NOTE ON NAMING, because it has already caused a false alarm: in this
# deployment OPENAI_API_KEY above is whatever provider OPENAI_BASE_URL points
# at — if that is api.anthropic.com, it holds an ANTHROPIC key despite the
# name. `python scripts/check_keys.py` reports every key against the endpoint
# that actually uses it, which is the only way to read these correctly.
#
# Default planner when a session doesn't choose one (overrides the registry).
# These drive the loops that do REAL building — UpgradeAgent (self-edits) and
# AppBuildAgent — so a frontier coding model belongs here, not a mid one:
# JARVIS_UPGRADE_PROFILE=or-codex-max
# JARVIS_APPBUILD_PROFILE=or-codex-max
#
# K4 — at bot startup, one live probe per configured key runs on a daemon
# thread; a credential the provider REFUSES (401/403) or cannot bill (402)
# turns that agent's model chip red in the Agents tab. `unreachable` never
# does — a network blip must not paint a working agent as broken. Set false
# to skip the probe entirely (every key then reads "unknown", which is the
# pre-K4 behaviour):
# JARVIS_KEY_HEALTH_ENABLED=true
#
# Part A — the developer's system prompt is assembled per task from a core
# plus the app-development / self-development / planning sections that
# apply, instead of carrying all three on every run. Fail-open: an
# unrecognised task gets every section, which is the pre-Part-A prompt byte
# for byte. Set false to always send the full prompt:
# JARVIS_DEVELOPER_SECTIONS_ENABLED=true
#
# MORTIMER_MEMORY_AUTOCONSOLIDATION_PLAN.md — at bot startup, on a detached
# daemon thread: auto-archives obvious duplicate fact clusters (never
# identity, never deletes — archives), classifies contradictions and audience
# (interaction/task-rule/implemented) via one small-model pass, and ages out
# stale system-tier facts. Ambiguous rows remain in the Memory panel's review
# queue for explicit inspection; they are never announced in the voice
# greeting or turned into a reconnect-time chore.
# facts. Also runs the MORTIMER_MEMORY_CAPACITY_PLAN.md "live = injected"
# capacity-enforcement ladder (merge, then mechanical age-out) so every live
# fact stays small enough to reach the prompt — one-shot rein-in any time
# with `python -m jarvis.memory_sweep --enforce`. Set false to disable the
# sweep entirely — nothing is touched, the review queue simply stops
# growing:
# JARVIS_MEMORY_SWEEP_ENABLED=true
# Dedicated background extraction/classification route. This is independent
# of OPENAI_MODEL, which is reserved for the voice Supervisor. The profile's
# provider key must be present in the vault before model-backed memory work is
# enabled; missing credentials fail closed without affecting voice.
# JARVIS_MEMORY_PROFILE=claude-sonnet-5
# Automated classification rollout is ordered and fail-closed. Keep shadow
# until the provider shadow and first-20 review gates have passed; then use
# explicit_preferences before corroborated_inferences.
# JARVIS_MEMORY_AUTOMATION_ENABLED=false
# JARVIS_MEMORY_AUTOMATION_SHADOW=true
# JARVIS_MEMORY_AUTOMATION_STAGE=shadow
# Background maintenance (KB digests and procedure descriptions) uses its
# own registry route; it never inherits the voice Supervisor's OPENAI_MODEL.
# JARVIS_BACKGROUND_PROFILE=claude-sonnet-5

# --- Self-development PR creation (optional; enables edit-mode submit) ---
# Fine-grained PAT scoped to THIS repo only: Contents (read/write) +
# Pull requests (read/write). NO administration, NO other repos. The agent
# can only ever open PRs — keep main a protected branch and merge yourself.
JARVIS_GITHUB_TOKEN=
JARVIS_GITHUB_REPO=Larryfix71566/jarvis-voice-ai

# --- Wake word (optional stretch) ---
# JARVIS_WAKEWORD_PORT=7862
# JARVIS_WAKEWORD_MODEL=models/mortimer.onnx
# JARVIS_WAKEWORD_THRESHOLD=0.5
# JARVIS_WAKEWORD_COOLDOWN=2.0

# --- Noise suppression (optional; voice isolation plan, Workstream A) ---
# Server-side neural noise suppression on the mic stream. OFF by default;
# enable for the A/B cohort with JARVIS_NS_ENABLED=true. Install one engine:
#   pip install deepfilternet   # DeepFilterNet 3 (best quality; pulls torch)
#   pip install pyrnnoise       # RNNoise (lighter fallback, plan A0)
# JARVIS_NS_ENABLED=true
# JARVIS_NS_FILTER=rnnoise         # rnnoise (default) | null | none.
#                                  # deepfilternet is NOT installable on
#                                  # py3.12 (see requirements.txt) — the
#                                  # config value still exists but degrades
#                                  # to pass-through with a warning.
# JARVIS_NS_ATTEN_LIM_DB=          # empty = full suppression; e.g. 12 keeps a
#                                  # natural noise floor (plan A3 strength knob)
# JARVIS_NS_POST_FILTER=false
# JARVIS_NS_LOG_STATS=true         # [ns] RTF/latency telemetry in logs/bot.log

# Speaker gate (MORTIMER_VOICE_ISOLATION_TIER12_PLAN.md Tier 2): a local
# ECAPA-TDNN speaker-verification gate on final transcripts only (never on
# interruptions — L7). OFF by default; requires enrollment first:
#   python -m jarvis.speaker enroll a.wav b.wav c.wav
# Fail-open everywhere (L5) — this is convenience filtering (TV, houseguests),
# NOT security: a recording of you defeats it. An utterance PASSES when ANY
# of: cosine score >= threshold; speech shorter than 1.0s (too little
# voiceprint to judge, e.g. "yes"/"confirm"); no profile enrolled; the model
# isn't on disk; or any error anywhere in the gate. A dropped utterance is
# dropped silently (log line only, no spoken reply — L6).
# JARVIS_SPEAKER_GATE_ENABLED=false
# JARVIS_SPEAKER_THRESHOLD=0.40

# --- Misc overrides (rarely needed) ---
# JARVIS_INTERRUPTION_NOTICE_ENABLED=true  # tell the Supervisor when the
#                                           # user genuinely barged in on a
#                                           # reply (plan Phase 3); set false
#                                           # to disable the context note
# JARVIS_MAX_PARALLEL_DELEGATIONS=3        # cap concurrent delegate_task
#                                           # executions when the Supervisor
#                                           # issues several in one turn
#                                           # (plan Phase 4)
# JARVIS_RUNLOG_ENABLED=true               # durable per-run logs for every
#                                           # sub-agent delegation (agent_runs/
#                                           # agent_events + logs/agents/*.jsonl);
#                                           # false is the kill switch — every
#                                           # write becomes a no-op
# JARVIS_RUNLOG_RETENTION_DAYS=30          # prune run-log rows/files older
#                                           # than this, once at bot startup;
#                                           # <= 0 disables pruning
# JARVIS_MEMORY_SWEEP_INTERVAL_S=300       # how often a live session's
#                                           # transcript is folded into
#                                           # long-term memory while it is
#                                           # still running, not just at
#                                           # teardown (reliable-memory plan)
# JARVIS_PROCEDURES_ENABLED=true           # learn + inject procedure hints
#                                           # from successful sub-agent runs
#                                           # (memory/procedures plan Part B);
#                                           # false is the kill switch — every
#                                           # write and every hint lookup
#                                           # becomes a no-op
# JARVIS_COUNCIL_ENABLED=true              # LLM Council for the self-edit
#                                           # loop's escalation path
#                                           # (MORTIMER_LLM_COUNCIL_PLAN.md);
#                                           # false is the kill switch — no
#                                           # fan-out, no logging, no cost;
#                                           # escalation falls through to the
#                                           # ordinary report-and-stop failure;
#                                           # read from the process
#                                           # environment — the run scripts
#                                           # export this file (V3)
# JARVIS_UI_CONTROL_ENABLED=true           # voice control of the console
#                                           # UI (drawer/tabs/transcript/
#                                           # display windows/mic/wake,
#                                           # MORTIMER_VOICE_UI_PLAN.md);
#                                           # false is the kill switch —
#                                           # the ui_control tool is not
#                                           # registered and the prompt
#                                           # addendum is omitted; buttons
#                                           # are unaffected
# JARVIS_COUNCIL_RETENTION_DAYS=180         # prune council_rounds/
#                                           # council_scores rows and
#                                           # logs/council/ dirs older than
#                                           # this, once at bot startup;
#                                           # <= 0 disables pruning. Kept
#                                           # much longer than the runlog's
#                                           # 30 days — pruning faster than
#                                           # shadowed rounds accumulate
#                                           # (25% sample) would permanently
#                                           # starve the judge-tier
#                                           # promotion decision (V11)
# JARVIS_PLANNING_PROFILE=kimi-k3          # default single-mode planner for
#                                           # the planning pathway
#                                           # (MORTIMER_PLANNING_PATHWAY_
#                                           # PLAN.md P7); independent of
#                                           # JARVIS_UPGRADE_PROFILE above —
#                                           # unset falls back to the
#                                           # registry's own default. No kill
#                                           # switch: the pathway only runs
#                                           # when explicitly started via
#                                           # plan_start or the Edit panel's
#                                           # Planning card
# JARVIS_APPBUILD_PROFILE=kimi-k3          # default planner for the
#                                           # app-build engine
#                                           # (MORTIMER_MODEL_DISCIPLINE_AND_
#                                           # MAC_SHELL_PLAN.md D7);
#                                           # independent of both
#                                           # JARVIS_UPGRADE_PROFILE and
#                                           # JARVIS_PLANNING_PROFILE above —
#                                           # unset falls back to the
#                                           # registry's own default. No kill
#                                           # switch: an app build only runs
#                                           # when explicitly started via
#                                           # app_build_start
# JARVIS_REPO_ROOT=                        # optional override of the repo
#                                           # root used by mcp-git/mcp-repo;
#                                           # normally UNSET (both servers
#                                           # locate the repo from their own
#                                           # file path). Values containing
#                                           # "${" are ignored as config
#                                           # leaks (developer-fix plan F2)
# JARVIS_DB_PATH=data/jarvis.db
# JARVIS_LOG_LEVEL=INFO
# JARVIS_BOT_PORT=7860
# JARVIS_WEBRTC_ENDPOINT=http://localhost:7860/api/offer
# JARVIS_TIMEZONE=America/New_York
# JARVIS_USER_NAME=Boss
# JARVIS_NAME=Mortimer
# JARVIS_UNITS=imperial   # imperial | metric — governs weather display units (W3, MORTIMER_WEATHER_FAHRENHEIT_AND_RADAR_PLAN.md)
# JARVIS_ADMIN_URL=http://127.0.0.1:7861   # where mcp-selfedit finds the sidecar

# Screen vision (MORTIMER_SHELL_FIX_AND_SCREEN_VISION_PLAN.md Part V).
# Lets Mortimer look at a connected display to answer "what's on my
# screen" and to verify UI/window placement while troubleshooting.
# EVERY captured screen is sent to a cloud vision API; this switch is the
# only off-ramp, and capture only ever happens inside an explicit tool
# call (no watcher, no schedule, nothing proactive). macOS also requires
# Screen Recording permission for the process running the bot.
# JARVIS_SCREEN_ENABLED=true
# JARVIS_VISION_PROFILE=claude-opus   # a vision:true profile in config/model_profiles.yaml
#
# Screen diagnostics (MORTIMER_SKILL_LIBRARY_PLAN.md Part G). Every
# capture logs one line — answer preview, display, byte size,
# low_confidence, profile, latency — on BOTH the sub-agent and the direct
# view_screen path (the direct one is not a delegation and so writes no
# run-log row; before this it was invisible). Additionally, a capture
# that comes back low_confidence has its IMAGE retained under
# logs/screen/ (gitignored): that is the wallpaper-only frame that proves
# a missing macOS Screen Recording grant, and it is pruned at bot startup
# after the window below. Successful captures are still never persisted.
# JARVIS_SCREEN_RETENTION_HOURS=48

# Clipboard handoff (MORTIMER_HANDOFF_LOOP_PLAN.md H4): the return channel
# for an investigation. Mortimer shows a command in the display window,
# you run it and copy the output, and "read my clipboard" hands it back so
# the specialist can continue with its budget reset.
# Runs in the admin sidecar via pbcopy/pbpaste (fixed argv, never a shell).
# Two properties hold by construction: a read is REFUSED unless a clear
# armed it — so Mortimer can only ever read what you copied after an
# explicit clear, never a password from an hour ago — and clipboard text
# never enters the transcript, so the memory sweep cannot persist it.
# What was read is shown in the display window, which is ephemeral.
# JARVIS_CLIPBOARD_ENABLED=true

# Ambient weather (Larry 2026-08-18): the console's top-left strip shows
# CURRENT weather, fetched by the admin sidecar (never the browser) from
# Open-Meteo (no API key) and cached 15 min. Location resolves as:
# these vars -> device location posted by the Mac shell -> IP geolocation.
# JARVIS_AMBIENT_WEATHER_ENABLED=true
# JARVIS_WEATHER_LAT=34.0754
# JARVIS_WEATHER_LON=-84.2941
# JARVIS_WEATHER_LABEL=Alpharetta

# Workflows (MORTIMER_KNOWLEDGE_FRAMEWORK_PLAN.md K4): authored, normative
# rules in config/workflows/*.yaml — how Larry wants a kind of task done,
# and what "done" means. Injected as ONE system message into a matching
# sub-agent run; guidance only, never an executor.
# JARVIS_WORKFLOWS_ENABLED=true

# Skills (MORTIMER_KNOWLEDGE_FRAMEWORK_PLAN.md K3): capability knowledge in
# the Agent Skills open format (skills/<name>/SKILL.md), so a community
# skill can be dropped in unchanged. Two things are true regardless of this
# switch: a skill does nothing until its name is listed in
# config/skills.yaml (one at a time, individually reviewed), and a bundled
# scripts/ directory is NEVER executed — Mortimer reads instructions only.
# Note the AGENT_ prefix: JARVIS_SKILLS_* would read as the MCP skill
# servers, which are a different thing entirely.
# JARVIS_AGENT_SKILLS_ENABLED=true

# --- security (T4a) ---
# Kill switch: false restores full environment inheritance for MCP children.
# JARVIS_ENV_SCOPING_ENABLED=true
# Kill switch: false disables financial detection and all turn suppression.
# JARVIS_SENSITIVE_GUARD_ENABLED=true
