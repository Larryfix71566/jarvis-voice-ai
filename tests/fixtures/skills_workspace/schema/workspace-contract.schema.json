{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortimer.invalid/schemas/skills-workspace-contract-v1.json",
  "title": "Mortimer Skills Workspace read and request contracts v1",
  "description": "Structural contract for synthetic workspace fixtures. Runtime ownership, privacy and cross-record checks remain covered by their owning services.",
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "catalogItem": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_id", "display_name", "description", "category", "revision", "installation", "enabled", "readiness", "readiness_reasons", "verification", "example_ids", "blockers"],
      "properties": {
        "skill_id": {"$ref": "#/$defs/slug"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "category": {"type": "string", "minLength": 1, "maxLength": 40},
        "revision": {"$ref": "#/$defs/revision"},
        "installation": {"enum": ["installed", "candidate", "catalog_only", "invalid"]},
        "enabled": {"type": "boolean"},
        "readiness": {"enum": ["ready", "blocked", "unknown"]},
        "readiness_reasons": {"$ref": "#/$defs/stringList"},
        "verification": {"enum": ["not_tested", "offline_passed", "live_passed", "failed", "stale"]},
        "example_ids": {"$ref": "#/$defs/stringList"},
        "blockers": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    },
    "processNode": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "title", "description", "inputs", "outputs", "tools", "approval", "success_criteria", "edges"],
      "properties": {
        "step_id": {"$ref": "#/$defs/slug"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 1200},
        "inputs": {"$ref": "#/$defs/stringList"},
        "outputs": {"$ref": "#/$defs/stringList"},
        "tools": {"$ref": "#/$defs/stringList"},
        "approval": {"type": ["string", "null"], "maxLength": 600},
        "success_criteria": {"$ref": "#/$defs/stringList"},
        "edges": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["to"], "properties": {"to": {"$ref": "#/$defs/slug"}, "condition": {"type": "string", "minLength": 1, "maxLength": 240}}}}
      }
    },
    "stringList": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}},
    "catalog": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "catalog_revision", "capabilities", "items", "next_cursor"],
      "properties": {
        "schema_version": {"const": 1}, "catalog_revision": {"$ref": "#/$defs/revision"},
        "capabilities": {"type": "object", "additionalProperties": false, "required": ["process_view", "activity_trace", "authoring"], "properties": {"process_view": {"type": "boolean"}, "activity_trace": {"type": "boolean"}, "authoring": {"type": "boolean"}}},
        "items": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/catalogItem"}},
        "next_cursor": {"type": ["string", "null"], "maxLength": 512}
      }
    },
    "detail": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "skill_id", "display_name", "description", "category", "version", "revision", "installation", "enabled", "readiness", "readiness_reasons", "verification", "capabilities", "required_tools", "required_credentials", "reference_paths", "example_ids", "related_workflow_ids", "compatible_with", "process_kind", "process_nodes", "source", "blockers"],
      "properties": {
        "schema_version": {"const": 1}, "skill_id": {"$ref": "#/$defs/slug"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 120}, "description": {"type": "string", "minLength": 1, "maxLength": 1024},
        "category": {"type": "string", "minLength": 1, "maxLength": 40}, "version": {"type": ["string", "null"], "maxLength": 80},
        "revision": {"$ref": "#/$defs/revision"}, "installation": {"enum": ["installed", "candidate", "catalog_only", "invalid"]},
        "enabled": {"type": "boolean"}, "readiness": {"enum": ["ready", "blocked", "unknown"]}, "readiness_reasons": {"$ref": "#/$defs/stringList"}, "verification": {"enum": ["not_tested", "offline_passed", "live_passed", "failed", "stale"]},
        "capabilities": {"$ref": "#/$defs/stringList"}, "required_tools": {"$ref": "#/$defs/stringList"}, "required_credentials": {"$ref": "#/$defs/stringList"},
        "reference_paths": {"$ref": "#/$defs/stringList"}, "example_ids": {"$ref": "#/$defs/stringList"}, "related_workflow_ids": {"$ref": "#/$defs/stringList"}, "compatible_with": {"$ref": "#/$defs/stringList"},
        "process_kind": {"enum": ["linear", "branching", "guidance", null]}, "process_nodes": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/processNode"}},
        "source": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "adaptation_notes", "immutable_revision", "license", "license_path", "source_digest"], "properties": {"kind": {"type": "string", "minLength": 1, "maxLength": 40}, "reference": {"type": ["string", "null"], "maxLength": 512}, "adaptation_notes": {"type": ["string", "null"], "maxLength": 1200}, "immutable_revision": {"type": ["string", "null"], "maxLength": 128}, "license": {"type": ["string", "null"], "maxLength": 120}, "license_path": {"type": ["string", "null"], "maxLength": 512}, "source_digest": {"type": ["string", "null"], "maxLength": 64}}},
        "blockers": {"$ref": "#/$defs/stringList"}
      }
    },
    "creatorRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "request_id", "expected_catalog_revision", "skill_id", "privacy_context"],
      "properties": {
        "schema_version": {"const": 1},
        "operation": {"enum": ["draft", "test", "request_publish", "request_activation", "request_rollback", "cancel"]},
        "request_id": {"type": "string", "format": "uuid"},
        "bot_session_id": {"type": ["string", "null"], "format": "uuid"},
        "expected_catalog_revision": {"$ref": "#/$defs/revision"},
        "skill_id": {"$ref": "#/$defs/slug"},
        "skill_revision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/revision"}]},
        "privacy_context": {"enum": ["standard", "protected"]},
        "task_brief": {"type": ["string", "null"], "minLength": 1, "maxLength": 8000},
        "example_ids": {"type": ["array", "null"], "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}},
        "scope": {"enum": ["offline", "live", null]},
        "route_policy_ref": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"},
        "budget": {"type": ["object", "null"], "additionalProperties": false, "properties": {"max_calls": {"type": "integer", "minimum": 1}, "max_seconds": {"type": "integer", "minimum": 1}}},
        "review_artifact_ref": {"type": ["string", "null"], "format": "uuid"},
        "candidate_digest": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/revision"}]},
        "job_id": {"type": ["string", "null"], "format": "uuid"}
      },
      "allOf": [
        {"if": {"properties": {"operation": {"const": "draft"}}}, "then": {"required": ["task_brief", "bot_session_id"], "properties": {"task_brief": {"type": "string", "minLength": 1, "maxLength": 8000}, "bot_session_id": {"type": "string", "format": "uuid"}}}},
        {"if": {"properties": {"operation": {"const": "test"}}}, "then": {"required": ["example_ids", "scope", "job_id"], "properties": {"example_ids": {"type": "array", "minItems": 1, "maxItems": 32}, "scope": {"enum": ["offline", "live"]}, "job_id": {"type": "string", "format": "uuid"}}}},
        {"if": {"properties": {"operation": {"const": "request_publish"}}}, "then": {"required": ["skill_revision", "review_artifact_ref", "candidate_digest"], "properties": {"skill_revision": {"$ref": "#/$defs/revision"}, "review_artifact_ref": {"type": "string", "format": "uuid"}, "candidate_digest": {"$ref": "#/$defs/revision"}}}},
        {"if": {"properties": {"operation": {"enum": ["request_activation", "request_rollback"]}}}, "then": {"required": ["skill_revision", "review_artifact_ref"], "properties": {"skill_revision": {"$ref": "#/$defs/revision"}, "review_artifact_ref": {"type": "string", "format": "uuid"}}}},
        {"if": {"properties": {"operation": {"const": "cancel"}}}, "then": {"required": ["job_id"], "properties": {"job_id": {"type": "string", "format": "uuid"}}}}
      ]
    },
    "activityEvent": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "event_id", "run_id", "request_id", "seq", "occurred_at", "skill_id", "skill_revision", "step_id", "attempt_id", "type", "status", "evidence_refs"],
      "properties": {
        "schema_version": {"const": 1},
        "event_id": {"type": "string", "format": "uuid"},
        "run_id": {"type": "string", "format": "uuid"},
        "request_id": {"type": "string", "format": "uuid"},
        "seq": {"type": "integer", "minimum": 0},
        "occurred_at": {"type": "string", "format": "date-time"},
        "skill_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/slug"}]},
        "skill_revision": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/revision"}]},
        "step_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/slug"}]},
        "attempt_id": {"type": ["string", "null"], "maxLength": 96},
        "type": {"enum": ["skill_selected", "skill_resource_read", "skill_step_started", "skill_step_finished", "skill_step_skipped", "skill_selection_refused", "protected_activity", "truncated"]},
        "status": {"enum": ["unknown", "running", "passed", "failed", "skipped"]},
        "evidence_refs": {
          "type": "array", "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": {"enum": ["tool_call_id", "check_receipt_id", "artifact_id"]},
              "id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "protected_activity"}}, "required": ["type"]},
          "then": {"properties": {"skill_id": {"type": "null"}, "skill_revision": {"type": "null"}, "step_id": {"type": "null"}, "status": {"const": "unknown"}, "evidence_refs": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"type": {"const": "skill_step_finished"}}, "required": ["type"]},
          "then": {"properties": {"status": {"enum": ["passed", "failed", "unknown"]}}}
        },
        {
          "if": {"properties": {"type": {"const": "skill_step_finished"}, "status": {"const": "passed"}}, "required": ["type", "status"]},
          "then": {"properties": {"evidence_refs": {"type": "array", "contains": {"type": "object", "properties": {"kind": {"const": "check_receipt_id"}}, "required": ["kind"]}}}}
        },
        {
          "if": {"properties": {"type": {"const": "skill_selected"}}, "required": ["type"]},
          "then": {"properties": {"status": {"const": "unknown"}}}
        },
        {
          "if": {"properties": {"type": {"const": "skill_step_started"}}, "required": ["type"]},
          "then": {"properties": {"status": {"const": "running"}}}
        },
        {
          "if": {"properties": {"type": {"const": "skill_resource_read"}}, "required": ["type"]},
          "then": {"properties": {"status": {"enum": ["passed", "failed", "unknown"]}}}
        },
        {
          "if": {"properties": {"type": {"const": "skill_step_skipped"}}, "required": ["type"]},
          "then": {"properties": {"status": {"const": "skipped"}}}
        },
        {
          "if": {"properties": {"type": {"const": "skill_selection_refused"}}, "required": ["type"]},
          "then": {"properties": {"status": {"enum": ["failed", "unknown"]}}}
        },
        {
          "if": {"properties": {"type": {"const": "truncated"}}, "required": ["type"]},
          "then": {"properties": {"status": {"const": "unknown"}, "evidence_refs": {"maxItems": 0}}}
        }
      ]
    }
  }
}
