{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mortimer.invalid/schemas/skill-metadata-v1.json",
  "title": "Mortimer Agent Skill metadata v1",
  "description": "Structural contract for mortimer.yaml after YAML parsing. The package validator additionally enforces cross-field identities, safe paths, acyclic process edges, and repository limits.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_id", "display_name", "category", "version", "source"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_id": {"type": "string", "pattern": "^(?!.*(?:anthropic|claude))[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 120},
    "category": {"type": "string", "minLength": 1, "maxLength": 40},
    "version": {"type": "string", "minLength": 1, "maxLength": 80},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"type": "string", "minLength": 1, "maxLength": 40},
        "reference": {"type": "string", "minLength": 1, "maxLength": 512},
        "immutable_revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "license": {"type": "string", "minLength": 1, "maxLength": 120},
        "license_path": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_digest": {"type": "string", "minLength": 1, "maxLength": 64},
        "adaptation_notes": {"type": "string", "minLength": 1, "maxLength": 1200}
      }
    },
    "capabilities": {"$ref": "#/$defs/stringList"},
    "required_tools": {"$ref": "#/$defs/stringList"},
    "required_credentials": {"$ref": "#/$defs/stringList"},
    "reference_paths": {"$ref": "#/$defs/stringList"},
    "example_ids": {"$ref": "#/$defs/stringList"},
    "related_workflow_ids": {"$ref": "#/$defs/stringList"},
    "compatible_with": {"$ref": "#/$defs/stringList"},
    "process": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "nodes"],
          "properties": {
            "kind": {"enum": ["linear", "branching", "guidance"]},
            "nodes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {"$ref": "#/$defs/processNode"}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 128}
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["to"],
      "properties": {
        "to": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
        "condition": {"type": "string", "minLength": 1, "maxLength": 240}
      }
    },
    "processNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "title", "description"],
      "properties": {
        "step_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 1200},
        "inputs": {"$ref": "#/$defs/stringList"},
        "outputs": {"$ref": "#/$defs/stringList"},
        "tools": {"$ref": "#/$defs/stringList"},
        "approval": {"type": ["string", "null"], "maxLength": 600},
        "success_criteria": {"$ref": "#/$defs/stringList"},
        "edges": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/edge"}
        }
      }
    }
  }
}
